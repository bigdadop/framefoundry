# Chatterbox Multilingual TTS environment (.venv-tts) — kept separate because chatterbox pins
# torch 2.6 / numpy<2 / transformers 5.2, which conflict with the core stack.
# chatterbox itself is installed by install.sh from the official repository at a pinned commit with
# --no-deps (that skips its gradio demo UI). These are its runtime dependencies.
torch==2.6.0
torchaudio==2.6.0
numpy==1.26.4
